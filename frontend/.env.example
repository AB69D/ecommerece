# Frontend environment variables.
# Copy this file to .env.local and fill in real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Backend API origin. The /api/:path* rewrite in next.config.mjs proxies through this.
# Local dev:    http://localhost:8080
# Production:   https://api.example.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Public site URL (used in SEO metadata, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base domain for tenant subdomains (multi-tenant SaaS). e.g. with
# NEXT_PUBLIC_BASE_DOMAIN=myapp.com, a visit to acme.myapp.com makes src/middleware.js
# forward `X-Tenant: acme` to the API. Must match the backend's PLATFORM_BASE_DOMAIN.
# Leave UNSET for single-tenant / local dev (no subdomain routing).
NEXT_PUBLIC_BASE_DOMAIN=
