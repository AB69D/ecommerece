# Caddy reverse proxy — backend-only (frontend is on Vercel).
# Currently serves HTTP on port 80 by IP (no domain yet).
# When you have a domain pointing at this VPS, replace `:80` block with
# `api.yourdomain.com { reverse_proxy backend:8080 }` and Caddy will
# auto-provision Let's Encrypt HTTPS.

:80 {
    encode zstd gzip
    reverse_proxy backend:8080
}
