# Caddy reverse proxy.
# /api/* and /healthz go straight to the Express backend.
# Everything else (/, /app/admin/*, /platform, /login, …) goes to the Next.js
# frontend.  Both services are on the internal Docker "app" network.

:80 {
    encode zstd gzip

    # ── Backend ──────────────────────────────────────────────────────────────
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle /healthz {
        reverse_proxy backend:8080
    }

    # ── Frontend (Next.js) ───────────────────────────────────────────────────
    handle {
        reverse_proxy frontend:3000
    }
}
